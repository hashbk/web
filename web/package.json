{
  "name": "rustdesk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure JS/TS business logic for the rustdesk web client (controller-only, force_relay over WebSocket).",
  "main": "dist/rustdesk-web.js",
  "scripts": {
    "gen-proto": "node scripts/gen-proto.mjs",
    "gen-lang": "node scripts/gen-lang.mjs",
    "build": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "inject-web": "bash scripts/inject-web.sh"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "libsodium-wrappers-sumo": "^0.8.4",
    "protobufjs": "^8.7.2"
  },
  "devDependencies": {
    "protobufjs-cli": "^2.6.2",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
